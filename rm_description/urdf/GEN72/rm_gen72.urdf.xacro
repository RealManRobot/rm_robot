    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rm_description/meshes/GEN72/Link1.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.218" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="Link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.0014" upper="3.0014" effort="25" velocity="3.141"/>
  </joint>
  <link name="Link2">
    <inertial>
      <origin xyz="-7.09647952406739E-07 -0.0576246216953338 -3.88440270542586E-05" rpy="0 0 0"/>
