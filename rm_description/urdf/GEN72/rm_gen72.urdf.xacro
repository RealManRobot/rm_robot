<?xml version='1.0' encoding='UTF-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rm_gen72">
  <xacro:include filename="$(find rm_description)/urdf/GEN72/rm_gen72.transmission.xacro"/>
  <xacro:include filename="$(find rm_description)/urdf/GEN72/rm_gen72.gazebo.xacro"/>
  <!-- Inertial matrix-->
  <xacro:macro name="inertial_matrix" params="mass">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="0.5" iyz="0.0" izz="1.0"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="Box_inertial_matrix" params="m l w h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(h*h + l*l)/12}" ixy="0" ixz="0" iyy="${m*(w*w + l*l)/12}" iyz="0" izz="${m*(w*w + h*h)/12}"/>
    </inertial>
  </xacro:macro>
  <link name="dummy">
    </link>
  <joint name="dummy_joint" type="fixed">
    <parent link="dummy"/>
    <child link="base_link"/>
  </joint>
  <!-- ///////////////////////////////////////   bottom_joint   //////////////////////////////////////////-->
  <joint name="bottom_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="bottom_link"/>
  </joint>
  <link name="bottom_link">
    <visual>
      <origin xyz=" 0 0 -0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.02"/>
      </geometry>
      <material name="Brown"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.02"/>
      </geometry>
    </collision>
    <xacro:Box_inertial_matrix m="500" l="1" w="1" h="0.02"/>
  </link>
  <link name="base_link">
    <inertial>
      <origin xyz="0.000608631599856789 0.000101410841223995 0.0500536423028974" rpy="0 0 0"/>
      <mass value="0.725732279372378"/>
      <inertia ixx="0.00116526259312761" ixy="3.86984764047093E-06" ixz="3.61598634195121E-05" iyy="0.00114387939249178" iyz="-1.69159565748085E-06" izz="0.000799620765266388"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rm_description/meshes/GEN72/base_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rm_description/meshes/GEN72/base_link.STL"/>
      </geometry>
    </collision>
  </link>
  <link name="Link1">
    <inertial>
      <origin xyz="3.54241616240111E-07 -6.0407327765511E-05 -0.0474562076947793" rpy="0 0 0"/>
      <mass value="0.511231576042974"/>
      <inertia ixx="0.000959440501675413" ixy="-1.90967914521862E-09" ixz="-7.95751539476377E-09" iyy="0.00102039305288465" iyz="1.46570590325122E-06" izz="0.000388714616194907"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rm_description/meshes/GEN72/Link1.STL"/>
