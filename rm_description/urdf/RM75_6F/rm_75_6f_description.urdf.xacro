      <inertia ixx="0.000780773999999998" ixy="-4.68999555539018e-07" ixz="1.21001722732377e-07" iyy="0.000763955885331537" iyz="0.000120511258963647" izz="0.000289972114668462"/>
    </inertial>
    <visual>
      <origin rpy="-1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://rm_description/meshes/dae/rm75/link_6.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="-1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://rm_description/meshes/RM75/link6.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint6" type="revolute">
    <origin rpy="1.5708 0 0" xyz="0 0 0"/>
    <parent link="Link5"/>
    <child link="Link6"/>
    <axis xyz="0 0.999999999993253 -3.67320510330504e-06"/>
    <limit lower="-2.234" upper="2.234" effort="10" velocity="3.14"/>
  </joint>
  <link name="Link7">
    <inertial>
      <origin rpy="0 0 0" xyz="0.00032231 -0.0001782 -0.028676"/>
      <mass value="0.14433"/>
      <inertia ixx="3.6119E-05" ixy="-1.3242E-06" ixz="-3.2733E-08" iyy="3.4626E-05" iyz="7.6694E-09" izz="6.1463E-05"/>
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
