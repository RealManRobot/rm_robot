<?xml version='1.0' encoding='UTF-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rm_75">
  <xacro:include filename="$(find rm_description)/urdf/RM75/rm_75.transmission.xacro"/>
  <xacro:include filename="$(find rm_description)/urdf/RM75/rm_75.gazebo.xacro"/>
  <!-- Inertial matrix-->
  <xacro:macro name="inertial_matrix" params="mass">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="0.5" iyz="0.0" izz="1.0"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="Box_inertial_matrix" params="m l w h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(h*h + l*l)/12}" ixy="0" ixz="0" iyy="${m*(w*w + l*l)/12}" iyz="0" izz="${m*(w*w + h*h)/12}"/>
    </inertial>
  </xacro:macro>
  <link name="dummy">
  </link>
  <joint name="dummy_joint" type="fixed">
    <parent link="dummy"/>
    <child link="base_link"/>
  </joint>
  <!-- ///////////////////////////////////////   bottom_joint   //////////////////////////////////////////-->
  <joint name="bottom_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="bottom_link"/>
  </joint>
  <link name="bottom_link">
    <visual>
      <origin xyz=" 0 0 -0.02"  rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.02" />
      </geometry>
      <material name="Brown" />
    </visual>
    <collision>
      <origin xyz=" 0 0 -0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.02"/>
      </geometry>
    </collision>
    <xacro:Box_inertial_matrix m="500" l="1" w="1" h="0.02"/>
  </link>
  <link name="base_link">
    <inertial>
      <origin xyz="0.00049987 5.2709E-05 0.060019" rpy="0 0 0"/>
      <mass value="1.862"/>
      <inertia ixx="0.0017232" ixy="-3.1058E-06" ixz="-3.7924E-05" iyy="0.0017051" iyz="1.3691E-06" izz="0.00090158"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://rm_description/meshes/dae/rm75/base_link.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://rm_description/meshes/RM75/base_link.STL"/>
      </geometry>
    </collision>
  </link>
  <link name="Link1">
    <inertial>
      <origin rpy="0 0 0" xyz="0.000241 0.00995004875438421 -0.0132729634515197"/>
      <mass value="1.574"/>
      <inertia ixx="0.002487573" ixy="7.90896450576573e-06" ixz="9.66302905131397e-06" iyy="0.00145055531790631" iyz="-0.00017939619746143" izz="0.00232103668209369"/>
    </inertial>
    <visual>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://rm_description/meshes/dae/rm75/link_1.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://rm_description/meshes/RM75/link1.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint1" type="revolute">
    <origin rpy="-1.5708 0 0" xyz="0 0 0.2405"/>
    <parent link="base_link"/>
    <child link="Link1"/>
    <axis xyz="0 -0.999999999993254 -3.67320510330504e-06"/>
    <limit lower="-3.106" upper="3.106" effort="60" velocity="3.14"/>
  </joint>
  <link name="Link2">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.000357 0.00532939225786383 0.10678898042477"/>
      <mass value="1.217"/>
      <inertia ixx="0.003494121" ixy="-5.61301072939424e-06" ixz="-2.92097938228005e-06" iyy="0.00344408428941695" iyz="0.000583874628319345" izz="0.000892716710583047"/>
    </inertial>
    <visual>
      <origin rpy="-1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://rm_description/meshes/dae/rm75/link_2.dae"/>
