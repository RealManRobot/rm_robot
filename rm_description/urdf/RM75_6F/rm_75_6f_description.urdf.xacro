    </collision>
  </link>
  <joint name="joint4" type="revolute">
    <origin rpy="1.5708 0 0" xyz="0 0 0"/>
    <parent link="Link3"/>
    <child link="Link4"/>
    <axis xyz="0 0.999999999993253 -3.67320510330504e-06"/>
    <limit lower="-2.356" upper="2.356" effort="30" velocity="3.14"/>
  </joint>
  <link name="Link5">
    <inertial>
      <origin rpy="0 0 0" xyz="7.79999999999999e-05 0.00878104752019518 -0.0129369677454987"/>
      <mass value="0.619"/>
      <inertia ixx="0.000627335999999999" ixy="1.34499399062738e-06" ixz="1.63600494044982e-06" iyy="0.000370291256906287" iyz="-3.49706323927397e-05" izz="0.000542454743093712"/>
    </inertial>
