    </collision>
  </link>
  <joint name="joint5" type="revolute">
    <origin rpy="-1.5708 0 0" xyz="0 7.71373071694059e-07 0.209999999998583"/>
    <parent link="Link4"/>
    <child link="Link5"/>
    <axis xyz="0 -0.999999999993253 -3.67320510330504e-06"/>
    <limit lower="-3.106" upper="3.106" effort="10" velocity="3.14"/>
  </joint>
  <link name="Link6">
    <inertial>
      <origin rpy="0 0 0" xyz="-1.4e-05 0.00281928843473851 0.078523989644705"/>
