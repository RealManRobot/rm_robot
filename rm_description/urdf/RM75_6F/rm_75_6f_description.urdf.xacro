    <parent link="Link1"/>
    <child link="Link2"/>
    <axis xyz="0 0.999999999993254 -3.67320510330504e-06"/>
    <limit lower="-2.2689" upper="2.2689" effort="60" velocity="3.14"/>
  </joint>
  <link name="Link3">
    <inertial>
      <origin rpy="0 0 0" xyz="3e-06 0.0113240513513309 -0.0139799584045311"/>
      <mass value="1.11"/>
      <inertia ixx="0.001836663" ixy="4.21599170220123e-06" ixz="2.25901548621747e-06" iyy="0.00106254527304991" iyz="-3.71686027285797e-05" izz="0.00149887472695008"/>
    </inertial>
    <visual>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://rm_description/meshes/dae/rm75/link_3.dae"/>
