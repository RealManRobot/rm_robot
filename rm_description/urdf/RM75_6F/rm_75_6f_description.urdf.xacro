    </collision>
  </link>
  <joint name="joint3" type="revolute">
    <origin rpy="-1.5708 0 0" xyz="0 9.40340506446091e-07 0.255999999998273"/>
    <parent link="Link2"/>
    <child link="Link3"/>
    <axis xyz="0 -0.999999999993254 -3.67320510330504e-06"/>
    <limit lower="-3.106" upper="3.106" effort="30" velocity="3.14"/>
  </joint>
  <link name="Link4">
    <inertial>
      <origin rpy="0 0 0" xyz="-5e-06 0.00474731096616561 0.0846579825627242"/>
      <mass value="0.685"/>
      <inertia ixx="0.001282444" ixy="-6.29997976059737e-07" ixz="5.51002314115497e-07" iyy="0.00125617870497235" iyz="0.000232080755951225" izz="0.000373011295027649"/>
    </inertial>
    <visual>
      <origin rpy="-1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://rm_description/meshes/dae/rm75/link_4.dae"/>
