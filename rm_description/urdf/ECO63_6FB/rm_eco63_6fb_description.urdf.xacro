<?xml version='1.0' encoding='UTF-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rm_eco63">
  <!-- arg link6_type-->
  <xacro:arg name="link6_type" default="Link6"/>
  <!-- arg->property-->
  <xacro:property name="link6_type" value="$(arg link6_type)"/>
  <xacro:include filename="$(find rm_description)/urdf/ECO63/rm_eco63.transmission.xacro"/>
  <xacro:include filename="$(find rm_description)/urdf/ECO63/rm_eco63.gazebo.xacro"/>
  <!-- Inertial matrix-->
  <xacro:macro name="inertial_matrix" params="mass">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="0.5" iyz="0.0" izz="1.0"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="Box_inertial_matrix" params="m l w h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(h*h + l*l)/12}" ixy="0" ixz="0" iyy="${m*(w*w + l*l)/12}" iyz="0" izz="${m*(w*w + h*h)/12}"/>
    </inertial>
  </xacro:macro>
  <link name="dummy">
    </link>
  <joint name="dummy_joint" type="fixed">
    <parent link="dummy"/>
    <child link="base_link"/>
  </joint>
  <!-- ///////////////////////////////////////   bottom_joint   //////////////////////////////////////////-->
  <joint name="bottom_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="bottom_link"/>
  </joint>
  <link name="bottom_link">
    <visual>
      <origin xyz=" 0 0 -0.02"  rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.02" />
      </geometry>
      <material name="Brown" />
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.02"/>
      </geometry>
    </collision>
    <xacro:Box_inertial_matrix m="500" l="1" w="1" h="0.02"/>
  </link>
  <link name="base_link">
    <inertial>
      <origin xyz="0.00020533 -8.2462E-05 0.042566" rpy="0 0 0"/>
      <mass value="1"/>
      <inertia ixx="0.00082414" ixy="-2.9336E-06" ixz="2.8699E-05" iyy="0.0008206" iyz="-2.2123E-06" izz="0.00068569"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://rm_description/meshes/dae/eco63/base_link.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rm_description/meshes/ECO63/base_link.STL"/>
      </geometry>
    </collision>
  </link>
  <link name="Link1">
    <inertial>
      <origin xyz="-0.0122 -0.0001 -0.0346" rpy="0 0 0"/>
      <mass value="1.6026"/>
      <inertia ixx="0.0020078355" ixy="-0.000043739" ixz="-0.0006663696" iyy="0.0033806191" iyz="-0.0000114927" izz="0.0025157844"/>
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://rm_description/meshes/dae/eco63/link1_v1.0.dae" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rm_description/meshes/ECO63/Link1.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.1625" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="Link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.106" upper="3.106" effort="60" velocity="3.14"/>
    <dynamics damping="50" friction="1"/>
  </joint>
  <link name="Link2">
    <inertial>
      <origin rpy="0 0 0" xyz="0.123600000728332 9.86871964907185e-05 0.0551000007331541"/>
      <mass value="2.8169"/>
      <inertia ixx="0.00305137723898191" ixy="2.86097284213423e-06" ixz="0.00369151818306214" iyy="0.059635782030822" iyz="-4.77799806514506e-06" izz="0.059632876930196"/>
    </inertial>
    <visual>
      <origin rpy="-3.14158530717959 0 -7.34641020638804e-06" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://rm_description/meshes/dae/eco63/link2_v1.0.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="-3.14158530717959 0 -7.34641020638804e-06" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://rm_description/meshes/ECO63/Link2.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint2" type="revolute">
    <origin rpy="-1.57079265348487 -1.57079265358979 3.14159265348487" xyz="-0.086 0 0"/>
    <parent link="Link1"/>
    <child link="Link2"/>
    <axis xyz="5.39695145436e-11 7.34641020638507e-06 -0.999999999973015"/>
    <limit lower="-3.106" upper="2.356" effort="60" velocity="3.14"/>
    <dynamics damping="50" friction="1"/>
  </joint>
  <link name="Link3">
    <inertial>
      <origin rpy="0 0 0" xyz="0.160246774026992 -9.88120953800659e-05 0.00679865060963923"/>
      <mass value="2.6857"/>
      <inertia ixx="0.00303448689033119" ixy="-7.56149251500227e-06" ixz="-0.00404883344765761" iyy="0.0669637574904248" iyz="-7.95641618581859e-06" izz="0.0659921968192439"/>
    </inertial>
    <visual>
      <origin rpy="-6.43905470160977e-08 -0.00872659994555747 7.41080075348466e-06" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://rm_description/meshes/dae/eco63/link3_v1.0.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="-6.43905470160977e-08 -0.00872659994555747 7.41080075348466e-06" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://rm_description/meshes/ECO63/Link3.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint3" type="revolute">
    <origin rpy="-3.14158530717959 -0.00872660000000014 0" xyz="0.409999999988936 -3.01202818462926e-06 0"/>
    <parent link="Link2"/>
    <child link="Link3"/>
    <axis xyz="-0.00872648918596077 -2.79725562366948e-10 0.999961923468332"/>
    <limit lower="-2.932" upper="2.7576" effort="30" velocity="3.14"/>
    <dynamics damping="50" friction="1"/>
  </joint>
  <link name="Link4">
    <inertial>
      <origin rpy="0 0 0" xyz="2.66160203449442e-07 -0.035899999999215 0.0036999999980435"/>
      <mass value="0.625"/>
      <inertia ixx="0.000545633601743592" ixy="-1.17310739645598e-07" ixz="-1.19697712100337e-07" iyy="0.000317334498257634" iyz="-0.0000813961" izz="0.0005169693"/>
    </inertial>
    <visual>
      <origin rpy="5.44983364746417e-11 3.17744588418378e-08 7.41065843880045e-06" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://rm_description/meshes/dae/eco63/link4_v1.0.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="5.44983364746417e-11 3.17744588418378e-08 7.41065843880045e-06" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://rm_description/meshes/ECO63/Link4.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint4" type="revolute">
    <origin rpy="-0.0087266 0 1.5708" xyz="0.380499512394097 2.81601353437318e-06 -0.0555806914397865"/>
    <parent link="Link3"/>
    <child link="Link4"/>
    <axis xyz="3.17744590494417e-08 -5.42628458021758e-11 0.999999999999999"/>
    <limit lower="-3.106" upper="3.106" effort="10" velocity="3.14"/>
    <dynamics damping="50" friction="1"/>
  </joint>
  <link name="Link5">
    <inertial>
      <origin rpy="0 0 0" xyz="-4.81280235991029e-08 0.0246000000003597 -0.0065999999984839"/>
      <mass value="0.6743"/>
      <inertia ixx="0.0006850659" ixy="-5.79550732114318e-07" ixz="-1.08014144854789e-08" iyy="0.0003873373" iyz="-0.000113520795720502" izz="0.0006178918"/>
    </inertial>
    <visual>
      <origin rpy="5.42627659536425e-11 7.41065832210452e-06 -3.18016794599308e-08" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://rm_description/meshes/dae/eco63/link5_v1.0.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="5.42627659536425e-11 7.41065832210452e-06 -3.18016794599308e-08" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://rm_description/meshes/ECO63/Link5.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint5" type="revolute">
    <origin rpy="1.5708 0 0" xyz="8.15172428261992e-07 -0.109999999996979 -5.99481932343507e-12"/>
    <parent link="Link4"/>
    <child link="Link5"/>
    <axis xyz="7.41065832198128e-06 -5.4498458344048e-11 0.999999999972541"/>
    <limit lower="-3.106" upper="3.106" effort="10" velocity="3.14"/>
    <dynamics damping="50" friction="1"/>
  </joint>
  <xacro:if value="${ link6_type =='Link6' }">
    <link name="Link6">
      <inertial>
        <origin rpy="0 0 0" xyz="0.000999999679050503 7.41120649346072e-09 -0.0101000000317744"/>
        <mass value="0.107"/>
        <inertia ixx="0.0000441232" ixy="-6.35329685252655e-08" ixz="-0.0000002997" iyy="0.0000350778" iyz="-2.89022206024016e-08" izz="0.0000654409"/>
      </inertial>
      <visual>
        <origin rpy="5.44983364746417e-11 3.17744588418378e-08 7.41065843880045e-06" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://rm_description/meshes/dae/eco63/link6_v1.0.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="5.44983364746417e-11 3.17744588418378e-08 7.41065843880045e-06" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://rm_description/meshes/ECO63/Link6.STL"/>
        </geometry>
      </collision>
    </link>
    <joint name="joint6" type="revolute">
      <origin rpy="-1.5708 0 0" xyz="2.52823355345104e-09 0.0794999999999999 4.31388822291248e-12"/>
      <parent link="Link5"/>
      <child link="Link6"/>
      <axis xyz="3.177445904944e-08 -5.42628458021758e-11 0.999999999999999"/>
      <limit lower="-6.28" upper="6.28" effort="10" velocity="3.14"/>
      <dynamics damping="50" friction="1"/>
    </joint>
  </xacro:if>
  <xacro:if value="${ link6_type =='Link6_6fb' }">
    <link name="Link6">
      <inertial>
        <origin rpy="0 0 0" xyz="0.000999999679050503 7.41120649346072e-09 -0.0101000000317744"/>
        <mass value="0.248"/>
        <inertia ixx="4.41232009230933e-05" ixy="-6.35329685252655e-08" ixz="-2.99699108468827e-07" iyy="3.50777990578641e-05" iyz="-2.89022206024016e-08" izz="6.54409000190423e-05"/>
      </inertial>
      <visual>
        <origin rpy="5.44983364746417e-11 3.17744588418378e-08 7.41065843880045e-06" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://rm_description/meshes/dae/eco63/link6Fb_v1.0.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="5.44983364746417e-11 3.17744588418378e-08 7.41065843880045e-06" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://rm_description/meshes/ECO63/Link6_6fb.STL"/>
        </geometry>
      </collision>
    </link>
    <joint name="joint6" type="revolute">
      <origin rpy="-1.5708 0 0" xyz="3.06886211205063e-09 0.0964999999999999 5.2363548869315e-12"/>
      <parent link="Link5"/>
      <child link="Link6"/>
      <axis xyz="3.177445904944e-08 -5.42628458021758e-11 0.999999999999999"/>
      <limit lower="-6.28" upper="6.28" effort="10" velocity="3.14"/>
    </joint>
  </xacro:if>
  <!-- Transmissions for ROS Control-->
  <xacro:macro name="transmission_block" params="joint_name">
    <transmission name="tran1">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${joint_name}">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="motor1">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
  </xacro:macro>
  <xacro:transmission_block joint_name="joint1"/>
  <xacro:transmission_block joint_name="joint2"/>
  <xacro:transmission_block joint_name="joint3"/>
  <xacro:transmission_block joint_name="joint4"/>
  <xacro:transmission_block joint_name="joint5"/>
  <xacro:transmission_block joint_name="joint6"/>
  <!-- ros_control plugin-->
  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>/arm</robotNamespace>
      <robotSimType>gazebo_ros_control/DefaultRobotHWSim</robotSimType>
      <legacyModeNS>true</legacyModeNS>
    </plugin>
  </gazebo>
</robot>
